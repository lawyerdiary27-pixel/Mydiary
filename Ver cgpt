  const response=await fetch(APPS_SCRIPT_URL+"?action=restore&scope=all&_="+Date.now(),{method:"GET",cache:"no-store"});
  const text=await response.text();if(!text)throw new Error("Empty restore response");
  const data=JSON.parse(text),cloudRecords=Array.isArray(data)?data:(Array.isArray(data.records)?data.records:[]);
  if(!cloudRecords.length){toast("Cloud backup is empty.");return;}
  const map=new Map(records.map(r=>[String(r.recordId),r]));let restored=0;
  cloudRecords.forEach(cr=>{if(!cr||typeof cr!=="object")return;cr.recordId=cr.recordId||cr.timestamp||uid();const key=String(cr.recordId),local=map.get(key);if(!local){map.set(key,cr);if(!cr.deleted)restored++;return;}const wasDeleted=!!local.deleted,ct=new Date(cr.updatedAt||0).getTime(),lt=new Date(local.updatedAt||0).getTime();if(!cr.deleted&&(wasDeleted||ct>=lt)){map.set(key,cr);if(wasDeleted)restored++;}});
