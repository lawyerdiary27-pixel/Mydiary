 </div>
 <div style="display:flex;gap:8px;flex-wrap:wrap">
  <button class="btn btn-success" id="openNewFileModalBtn">➕ Add New File</button>
  <button class="btn btn-warning" id="topAddDateBtn">📅 Add Hearing Date</button>
  <button class="btn btn-light" id="googleLoginBtn">☁️ Connect Drive</button>
  <button class="btn btn-light" id="restoreCloudBtn">🔄 Restore Cloud</button>
 </div>
</header>

<div class="stats-grid">
 <div class="stat-card">
