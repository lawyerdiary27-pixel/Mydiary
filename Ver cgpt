  const fieldDivs = grid.querySelectorAll(".field[data-field-id]");
  const newFields = [];
  fieldDivs.forEach(div=>{
   const fid = div.dataset.fieldId;
   const found = sec.fields.find(f=>f[0]===fid);
   if(found) newFields.push(found);
  });
  sec.fields = newFields;
 });
 saveLayout();
}

