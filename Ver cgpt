 if($("syncStatus"))$("syncStatus").textContent="☁ Connecting...";
 try{
  const response=await fetch(APPS_SCRIPT_URL+"?action=get&_="+Date.now(),{method:"GET",cache:"no-store"});
  const text=await response.text();if(!text)throw new Error("Empty cloud response");
  const data=JSON.parse(text),cloudRecords=Array.isArray(data)?data:(Array.isArray(data.records)?data.records:[]);
  const map=new Map(records.map(r=>[String(r.recordId),r]));
  cloudRecords.forEach(cr=>{if(!cr||typeof cr!=="object")return;cr.recordId=cr.recordId||cr.timestamp||uid();const key=String(cr.recordId),local=map.get(key);if(!local){map.set(key,cr);return;}const lt=new Date(local.updatedAt||local.createdAt||0).getTime(),ct=new Date(cr.updatedAt||cr.createdAt||0).getTime();if(ct>=lt)map.set(key,cr);});
