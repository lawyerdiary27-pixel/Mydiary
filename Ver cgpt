   </div>
   <div style="display:flex;justify-content:flex-end;gap:10px">
    <button type="button" class="btn btn-light" data-close="customFieldModal">Cancel</button>
    <button type="submit" class="btn btn-primary">Create Field</button>
   </div>
  </form>
 </div>
</div>

